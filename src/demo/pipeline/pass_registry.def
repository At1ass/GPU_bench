// Canonical render pass registry — single source of truth.
// Format: PASS(ClassName)
//
// Adding a new pass: add one line here + create the .h/.cpp files.
// The factory auto-creates and init()s all passes listed below.
//
// Special passes that need sub-pass wiring (SceneToFBOPass,
// TessellatedModelPass) are NOT listed here — they are handled
// manually in pass_factory.cpp after the registry expansion.

PASS(SkyPass)
PASS(ShadowPass)
PASS(OpaquePass)
PASS(GrassInstancedPass)
PASS(FurPass)
PASS(ParticlePass)
PASS(TorchPass)
PASS(SSAOPass)
PASS(BloomPass)
PASS(CompositePass)
PASS(HDRCompositePass)
PASS(ComputeParticlesPass)
PASS(ComputeParticlesDrawPass)
PASS(GTAOPass)
PASS(BloomComputePass)
PASS(AutoExposurePass)
PASS(VolumetricFogPass)
PASS(WaterPass)
PASS(SSRPass)
PASS(SSRCopyPass)
PASS(DoFPass)
