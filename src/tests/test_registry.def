// Canonical test registry — single source of truth for all tests.
// Format: X(id, class, display_name, cli_name, category, description, unit, preset_field, caps)
//
// Adding a new test = adding one line here. Everything else is generated.
// caps: bitmask of TestCap flags required to run this test.

X(Fillrate,    FillrateTest,    "Fillrate",    "fillrate",     Fill,     "Pixel fill throughput (opaque quads)",  "MPix/s",   fillrate,    Cap_None)
X(Geometry,    GeometryTest,    "Geometry",    "geometry",     Geometry, "Triangle throughput",                   "Mtri/s",   geometry,    Cap_None)
X(Texturing,   TexturingTest,   "Texturing",   "texturing",    Fill,     "Texture sampling rate",                "MTex/s",   texturing,   Cap_None)
X(Scene,       SceneTest,       "Scene",       "scene",        Mixed,    "Complex scene rendering workload",     "FPS",      scene,       Cap_None)
X(DrawCall,    DrawCallTest,    "DrawCall",    "drawcall",     Overhead, "Driver draw call overhead",            "calls/s",  drawcall,    Cap_None)
X(Overdraw,    OverdrawTest,    "Overdraw",    "overdraw",     Fill,     "ROP overdraw stress (blended quads)",  "MPix/s",   overdraw,    Cap_None)
X(TexUpload,   TexUploadTest,   "TexUpload",   "texupload",    Overhead, "Texture upload bandwidth",             "MB/s",     texupload,   Cap_None)
X(StateChange, StateChangeTest, "StateChange", "statechange",  Overhead, "Pipeline state change overhead",       "ops/s",    statechange, Cap_None)
X(Vertex,      VertexTest,      "Vertex",      "vertex",       Geometry, "Vertex processing rate",               "Mverts/s", vertex,      Cap_None)
X(ShaderALU,   ShaderALUTest,   "ShaderALU",   "shader_alu",   Compute,  "Shader ALU throughput (sin/cos/pow)",  "GOps/s",   shader_alu,  Cap_None)
X(ShaderFMA,   ShaderFMATest,   "ShaderFMA",   "shader_fma",   Compute,  "Shader FMA throughput (pure MAD)",     "GFLOP/s",  shader_fma,  Cap_None)
X(DrawCallRaw,   DrawCallRawTest,   "DrawCallRaw",   "drawcall_raw",   Overhead,  "Raw driver submission (no uniforms)",       "calls/s",  drawcall,       Cap_None)
X(InstancedDraw, InstancedDrawTest, "InstancedDraw", "instanced_draw", Geometry,  "Instanced rendering throughput (GL3+)",    "Mtri/s",   instanced_draw, Cap_Instancing)
X(ComputeFMA,    ComputeFMATest,    "ComputeFMA",    "compute_fma",    Compute,   "Compute shader FMA throughput (GL4.3+)",   "GFLOP/s",  compute_fma,    Cap_Compute)
X(FBOFillrate,       FBOFillrateTest,       "FBOFillrate",       "fbo_fillrate",       Fill,     "FBO render-to-texture fillrate (GL3+)",          "MPix/s",   fbo_fillrate,       Cap_GL3 | Cap_FBO)
X(MRTFill,           MRTFillTest,           "MRTFill",           "mrt_fill",           Fill,     "Multiple render target fill throughput (GL3+)",   "MPix/s",   mrt_fill,           Cap_GL3 | Cap_FBO)
X(TexArraySample,    TexArraySampleTest,    "TexArraySample",    "texarray_sample",    Fill,     "Texture array sampling rate (GL3+)",              "MTex/s",   texarray_sample,    Cap_GL3)
X(GeomShader,        GeometryShaderTest,    "GeomShader",        "geom_shader",        Geometry, "Geometry shader amplification (GL3.2+)",          "Mtri/s",   geom_shader,        Cap_GeometryShader)
X(UBOSwitch,         UBOSwitchTest,         "UBOSwitch",         "ubo_switch",         Overhead, "UBO binding switch overhead (GL3+)",              "ops/s",    ubo_switch,         Cap_GL3)
X(TransformFeedback, TransformFeedbackTest, "TransformFeedback", "transform_feedback", Geometry, "Transform feedback vertex throughput (GL3+)",     "Mverts/s", transform_feedback, Cap_GL3)
X(ComputeBW,         ComputeBandwidthTest,  "ComputeBW",         "compute_bw",         Compute,  "Compute shader memory bandwidth (GL4.3+)",       "GB/s",     compute_bw,         Cap_Compute)
X(IndirectDraw,      IndirectDrawTest,      "IndirectDraw",      "indirect_draw",      Overhead, "Multi-draw indirect throughput (GL4.3+)",         "calls/s",  indirect_draw,      Cap_GL4)
X(ComputeSMem,       ComputeSharedMemTest,  "ComputeSMem",       "compute_smem",       Compute,  "Compute shared memory bandwidth (GL4.3+)",       "GB/s",     compute_smem,       Cap_Compute)
X(SSBOAtomics,       SSBOAtomicsTest,       "SSBOAtomics",       "ssbo_atomics",       Compute,  "SSBO atomic operation throughput (GL4.3+)",      "GOps/s",   ssbo_atomics,       Cap_Compute)
X(TessellationTP,    TessellationTPTest,    "TessellationTP",    "tess_tp",            Geometry, "Tessellation shader throughput (GL4.0+)",        "Mtri/s",   tess_tp,            Cap_Tessellation)
X(TextureGather,     TextureGatherTest,     "TextureGather",     "tex_gather",         Fill,     "textureGather vs texelFetch (GL4.0+)",           "MTex/s",   tex_gather,         Cap_GL4)
X(ImageLoadStore,    ImageLoadStoreTest,    "ImageLoadStore",    "image_ls",           Compute,  "Image load/store vs SSBO (GL4.2+)",              "GB/s",     image_ls,           Cap_ImageLoadStore | Cap_Compute)
X(ComputePrefix,     ComputePrefixTest,     "ComputePrefix",     "compute_prefix",     Compute,  "Parallel prefix sum (scan) (GL4.3+)",            "GB/s",     compute_prefix,     Cap_Compute)
X(PersistentMap,     PersistentMapTest,     "PersistentMap",     "persistent_map",     Overhead, "Persistent buffer mapping throughput (GL4.4+)",  "GB/s",     persistent_map,     Cap_BufferStorage)
X(BindlessTex,       BindlessTexTest,       "BindlessTex",       "bindless_tex",       Overhead, "Bindless texture throughput (ARB ext)",           "ops/s",    bindless_tex,       Cap_BindlessTexture | Cap_GL4)
