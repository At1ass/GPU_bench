// Canonical test registry — single source of truth for all tests.
// Format: X(id, class, display_name, cli_name, category, description, unit, preset_field)
//
// Adding a new test = adding one line here. Everything else is generated.

X(Fillrate,    FillrateTest,    "Fillrate",    "fillrate",     Fill,     "Pixel fill throughput (opaque quads)",  "MPix/s",   fillrate)
X(Geometry,    GeometryTest,    "Geometry",    "geometry",     Geometry, "Triangle throughput",                   "Mtri/s",   geometry)
X(Texturing,   TexturingTest,   "Texturing",   "texturing",    Fill,     "Texture sampling rate",                "MTex/s",   texturing)
X(Scene,       SceneTest,       "Scene",       "scene",        Mixed,    "Complex scene rendering workload",     "FPS",      scene)
X(DrawCall,    DrawCallTest,    "DrawCall",    "drawcall",     Overhead, "Driver draw call overhead",            "calls/s",  drawcall)
X(Overdraw,    OverdrawTest,    "Overdraw",    "overdraw",     Fill,     "ROP overdraw stress (blended quads)",  "MPix/s",   overdraw)
X(TexUpload,   TexUploadTest,   "TexUpload",   "texupload",    Overhead, "Texture upload bandwidth",             "MB/s",     texupload)
X(StateChange, StateChangeTest, "StateChange", "statechange",  Overhead, "Pipeline state change overhead",       "ops/s",    statechange)
X(Vertex,      VertexTest,      "Vertex",      "vertex",       Geometry, "Vertex processing rate",               "Mverts/s", vertex)
X(ShaderALU,   ShaderALUTest,   "ShaderALU",   "shader_alu",   Compute,  "Shader ALU throughput (sin/cos/pow)",  "GFLOP/s",  shader_alu)
X(ShaderFMA,   ShaderFMATest,   "ShaderFMA",   "shader_fma",   Compute,  "Shader FMA throughput (pure MAD)",     "GFLOP/s",  shader_fma)
X(DrawCallRaw, DrawCallRawTest, "DrawCallRaw", "drawcall_raw", Overhead, "Raw driver submission (no uniforms)",  "calls/s",  drawcall)
