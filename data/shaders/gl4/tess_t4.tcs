#version 430
layout(vertices = 3) out;

in vec3 v_pos[];
in vec3 v_normal[];
in vec2 v_uv[];

out vec3 tc_pos[];
out vec3 tc_normal[];
out vec2 tc_uv[];

uniform float u_tess_inner;
uniform float u_tess_outer;
uniform vec3 u_cam_pos;
uniform mat4 u_model;

void main() {
    // Pass through per-vertex attributes
    tc_pos[gl_InvocationID] = v_pos[gl_InvocationID];
    tc_normal[gl_InvocationID] = v_normal[gl_InvocationID];
    tc_uv[gl_InvocationID] = v_uv[gl_InvocationID];

    // Only compute tessellation levels once per patch (invocation 0)
    if (gl_InvocationID == 0) {
        // Distance-adaptive tessellation: higher near camera
        // Compute world-space center of the triangle patch
        vec3 center = (v_pos[0] + v_pos[1] + v_pos[2]) / 3.0;
        vec3 world_center = (u_model * vec4(center, 1.0)).xyz;
        float dist = length(world_center - u_cam_pos);

        // Scale tessellation by distance: full at dist<2, minimal at dist>12
        float tess_scale = clamp(1.0 - (dist - 2.0) / 10.0, 0.1, 1.0);

        float inner = max(u_tess_inner * tess_scale, 1.0);
        float outer = max(u_tess_outer * tess_scale, 1.0);

        // Per-edge outer levels (could be refined per-edge for cracks-free LOD)
        // For now use uniform outer level
        gl_TessLevelInner[0] = inner;
        gl_TessLevelOuter[0] = outer;
        gl_TessLevelOuter[1] = outer;
        gl_TessLevelOuter[2] = outer;
    }
}
