#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer HistogramBuffer {
    uint histogram[256];
};

layout(std430, binding = 2) buffer ExposureBuffer {
    float exposure_value;
};

uniform float u_min_log_lum;
uniform float u_log_lum_range;
uniform float u_total_pixels;
uniform float u_adapt_speed;
uniform float u_dt;

// Shared memory for parallel reduction
shared uint s_histogram[256];

void main() {
    uint lid = gl_LocalInvocationIndex;

    // Load histogram into shared memory
    s_histogram[lid] = histogram[lid];
    barrier();

    // Only thread 0 computes the result
    if (lid == 0u) {
        // Trim 2% from low and high ends
        uint low_cut = uint(u_total_pixels * 0.02);
        uint high_cut = uint(u_total_pixels * 0.98);

        float weighted_sum = 0.0;
        uint counted = 0u;
        uint running_count = 0u;

        for (int i = 0; i < 256; i++) {
            uint prev_count = running_count;
            running_count += s_histogram[i];

            // Skip bins outside the trimmed range
            if (running_count <= low_cut) continue;
            if (prev_count >= high_cut) break;

            // Clamp contribution to trimmed range
            uint lo = max(prev_count, low_cut);
            uint hi = min(running_count, high_cut);
            uint contrib = hi - lo;

            // Bin center in log luminance space
            float bin_center = (float(i) - 0.5) / 254.0 * u_log_lum_range + u_min_log_lum;
            weighted_sum += bin_center * float(contrib);
            counted += contrib;
        }

        float avg_log_lum = (counted > 0u) ? weighted_sum / float(counted) : 0.0;
        float avg_lum = exp2(avg_log_lum);

        // Target exposure: standard 18% middle-gray reference
        float target_exposure = 0.18 / max(avg_lum, 0.001);
        target_exposure = clamp(target_exposure, 0.05, 4.0);

        // Temporal smoothing
        float prev = exposure_value;
        if (prev < 0.01) prev = 1.0; // first frame
        float speed = u_adapt_speed * u_dt;
        speed = clamp(speed, 0.0, 1.0);
        exposure_value = prev + (target_exposure - prev) * speed;

        // Clear histogram for next frame
        for (int i = 0; i < 256; i++) {
            histogram[i] = 0u;
        }
    }
}
