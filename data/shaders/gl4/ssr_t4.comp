#version 430
layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_scene_tex;
uniform sampler2D u_depth_tex;

layout(rgba32f, binding = 0) writeonly uniform image2D u_ssr_out;

uniform mat4 u_proj;
uniform mat4 u_view_inv;   // camera-to-world (for world-space normal check)
uniform vec2 u_screen_size;
uniform float u_near;
uniform float u_far;
uniform float u_aspect;
uniform float u_tan_half_fov;

// Puddle exclusion: SSR skips water pixels (water shader handles its own reflections)
uniform vec3 u_puddle_pos[3];
uniform float u_puddle_radius[3];
uniform int u_puddle_count;

float linearizeDepth(float d) {
    return u_near * u_far / (u_far - d * (u_far - u_near));
}

vec3 viewPosFromUV(vec2 uv, float linearZ) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(
        ndc.x * u_tan_half_fov * u_aspect * linearZ,
        ndc.y * u_tan_half_fov * linearZ,
        -linearZ
    );
}

vec3 reconstructViewNormal(vec2 uv, float centerZ) {
    vec2 texel = 1.0 / u_screen_size;
    float dR = linearizeDepth(texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r);
    float dU = linearizeDepth(texture(u_depth_tex, uv + vec2(0.0, texel.y)).r);
    float dL = linearizeDepth(texture(u_depth_tex, uv - vec2(texel.x, 0.0)).r);
    float dD = linearizeDepth(texture(u_depth_tex, uv - vec2(0.0, texel.y)).r);

    vec3 center = viewPosFromUV(uv, centerZ);
    vec3 right, up;
    if (abs(dR - centerZ) < abs(dL - centerZ))
        right = viewPosFromUV(uv + vec2(texel.x, 0.0), dR) - center;
    else
        right = center - viewPosFromUV(uv - vec2(texel.x, 0.0), dL);
    if (abs(dU - centerZ) < abs(dD - centerZ))
        up = viewPosFromUV(uv + vec2(0.0, texel.y), dU) - center;
    else
        up = center - viewPosFromUV(uv - vec2(0.0, texel.y), dD);

    return normalize(cross(right, up));
}

vec2 projectToUV(vec3 viewPos) {
    vec4 clip = u_proj * vec4(viewPos, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    return ndc.xy * 0.5 + 0.5;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen_size = ivec2(u_screen_size);

    if (gid.x >= screen_size.x || gid.y >= screen_size.y) return;

    vec2 uv = (vec2(gid) + 0.5) / u_screen_size;

    float depth = texture(u_depth_tex, uv).r;
    float linearZ = linearizeDepth(depth);

    if (linearZ > 40.0 || linearZ < 0.2) {
        imageStore(u_ssr_out, gid, vec4(0.0));
        return;
    }

    vec3 viewNormal = reconstructViewNormal(uv, linearZ);
    vec3 viewPos = viewPosFromUV(uv, linearZ);

    // SSR only inside puddle zones (water surfaces)
    vec3 worldPos = (u_view_inv * vec4(viewPos, 1.0)).xyz;
    bool in_puddle = false;
    for (int p = 0; p < u_puddle_count && p < 3; p++) {
        vec2 delta = worldPos.xz - u_puddle_pos[p].xz;
        if (dot(delta, delta) < u_puddle_radius[p] * u_puddle_radius[p]) {
            in_puddle = true;
            break;
        }
    }
    if (!in_puddle) {
        imageStore(u_ssr_out, gid, vec4(0.0));
        return;
    }
    vec3 viewDir = normalize(viewPos);

    // Convert normal to WORLD space for proper "upward-facing" check
    vec3 worldNormal = normalize((u_view_inv * vec4(viewNormal, 0.0)).xyz);

    // Depth variance check: reject noisy normals at depth discontinuities
    // (curved surfaces like the bunny produce unreliable depth-reconstructed normals)
    vec2 texel = 1.0 / u_screen_size;
    float dR = linearizeDepth(texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r);
    float dL = linearizeDepth(texture(u_depth_tex, uv - vec2(texel.x, 0.0)).r);
    float dU = linearizeDepth(texture(u_depth_tex, uv + vec2(0.0, texel.y)).r);
    float dD = linearizeDepth(texture(u_depth_tex, uv - vec2(0.0, texel.y)).r);
    float depth_variance = abs(dR - dL) + abs(dU - dD);
    float depth_threshold = linearZ * 0.08; // 8% of current depth
    float normal_confidence = 1.0 - smoothstep(0.0, depth_threshold, depth_variance);

    // Reflectivity: horizontal surfaces (puddles, flat terrain)
    float up_facing = max(worldNormal.y, 0.0);
    float horizontal = smoothstep(0.88, 0.98, up_facing);
    float reflectivity = horizontal * normal_confidence * 0.7;

    if (reflectivity < 0.05) {
        imageStore(u_ssr_out, gid, vec4(0.0));
        return;
    }

    // Reflection direction in view space
    vec3 reflDir = reflect(viewDir, viewNormal);

    // Ray march with jitter to reduce banding
    float jitter = fract(dot(vec2(gid), vec2(0.75487766, 0.56984029)));

    vec3 ray_pos = viewPos;
    float step_size = 0.12;   // initial step
    float max_dist = 15.0;
    float traveled = step_size * jitter;  // jittered start
    ray_pos += reflDir * traveled;

    vec3 hit_color = vec3(0.0);
    float confidence = 0.0;

    for (int i = 0; i < 48; i++) {
        ray_pos += reflDir * step_size;
        traveled += step_size;
        if (traveled > max_dist) break;

        vec2 sample_uv = projectToUV(ray_pos);
        if (sample_uv.x < 0.01 || sample_uv.x > 0.99 || sample_uv.y < 0.01 || sample_uv.y > 0.99)
            break;

        float sample_depth = linearizeDepth(texture(u_depth_tex, sample_uv).r);
        float ray_depth = -ray_pos.z;
        float depth_diff = ray_depth - sample_depth;

        // Hit: ray went behind geometry, but not too far behind (thickness check)
        if (depth_diff > 0.0 && depth_diff < step_size * 4.0) {
            // Binary refinement (6 steps for sub-pixel precision)
            vec3 refine_pos = ray_pos - reflDir * step_size;
            float refine_step = step_size * 0.5;
            for (int j = 0; j < 6; j++) {
                refine_pos += reflDir * refine_step;
                vec2 ref_uv = projectToUV(refine_pos);
                float ref_depth = linearizeDepth(texture(u_depth_tex, ref_uv).r);
                if (-refine_pos.z > ref_depth)
                    refine_pos -= reflDir * refine_step;
                refine_step *= 0.5;
            }

            vec2 final_uv = projectToUV(refine_pos);
            hit_color = texture(u_scene_tex, final_uv).rgb;

            // Confidence: fade at screen edges, distance, depth thickness
            float edge_fade = 1.0;
            edge_fade *= smoothstep(0.0, 0.1, final_uv.x) * smoothstep(1.0, 0.9, final_uv.x);
            edge_fade *= smoothstep(0.0, 0.1, final_uv.y) * smoothstep(1.0, 0.9, final_uv.y);
            float dist_fade = 1.0 - smoothstep(max_dist * 0.3, max_dist, traveled);
            // Thin-geometry rejection: if depth difference is large, it's behind something thick
            float thickness_fade = 1.0 - smoothstep(step_size * 1.5, step_size * 4.0, depth_diff);

            confidence = edge_fade * dist_fade * thickness_fade * reflectivity;
            break;
        }

        // Adaptive step: grow slowly to cover more distance
        step_size *= 1.04;
    }

    imageStore(u_ssr_out, gid, vec4(hit_color, confidence));
}
