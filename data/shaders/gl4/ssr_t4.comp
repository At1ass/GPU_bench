#version 430
layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_scene_tex;
uniform sampler2D u_depth_tex;

layout(rgba32f, binding = 0) writeonly uniform image2D u_ssr_out;

uniform mat4 u_proj;
uniform mat4 u_view;
uniform mat4 u_view_inv;
uniform vec2 u_screen_size;
uniform float u_near;
uniform float u_far;
uniform float u_aspect;
uniform float u_tan_half_fov;

// Puddle zones
uniform vec3 u_puddle_pos[3];
uniform float u_puddle_radius[3];
uniform int u_puddle_count;

// Mirror
uniform vec3 u_mirror_pos;
uniform vec3 u_mirror_normal;
uniform vec2 u_mirror_half_size;
uniform int u_has_mirror;

float linearizeDepth(float d) {
    return u_near * u_far / (u_far - d * (u_far - u_near));
}

vec3 viewPosFromUV(vec2 uv, float linearZ) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * u_tan_half_fov * u_aspect * linearZ,
                ndc.y * u_tan_half_fov * linearZ,
                -linearZ);
}

vec3 reconstructViewNormal(vec2 uv, float centerZ) {
    vec2 texel = 1.0 / u_screen_size;
    float dR = linearizeDepth(texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r);
    float dU = linearizeDepth(texture(u_depth_tex, uv + vec2(0.0, texel.y)).r);
    float dL = linearizeDepth(texture(u_depth_tex, uv - vec2(texel.x, 0.0)).r);
    float dD = linearizeDepth(texture(u_depth_tex, uv - vec2(0.0, texel.y)).r);
    vec3 center = viewPosFromUV(uv, centerZ);
    vec3 right = (abs(dR - centerZ) < abs(dL - centerZ))
        ? viewPosFromUV(uv + vec2(texel.x, 0.0), dR) - center
        : center - viewPosFromUV(uv - vec2(texel.x, 0.0), dL);
    vec3 up = (abs(dU - centerZ) < abs(dD - centerZ))
        ? viewPosFromUV(uv + vec2(0.0, texel.y), dU) - center
        : center - viewPosFromUV(uv - vec2(0.0, texel.y), dD);
    return normalize(cross(right, up));
}

// Project view-space position to screen pixel coords + linear depth
// Returns (pixel.x, pixel.y, linearZ)
vec3 projectToScreen(vec3 viewPos) {
    vec4 clip = u_proj * vec4(viewPos, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    return vec3((ndc.xy * 0.5 + 0.5) * u_screen_size, -viewPos.z);
}

// ============================================================
// Screen-space DDA ray march (Morgan McGuire 2014)
// Traces a ray pixel-by-pixel in screen space for artifact-free SSR
// ============================================================
vec4 ssrTrace(vec3 vsOrigin, vec3 vsDir) {
    // Project ray start and a point along the ray to screen space
    float ray_length = 20.0;
    vec3 vsEnd = vsOrigin + vsDir * ray_length;

    // Clip ray end to near plane to avoid projection issues
    if (vsEnd.z > -u_near) {
        float t = (-u_near - vsOrigin.z) / vsDir.z;
        vsEnd = vsOrigin + vsDir * max(t, 0.0);
    }

    vec3 screen0 = projectToScreen(vsOrigin); // (px, py, linearZ)
    vec3 screen1 = projectToScreen(vsEnd);

    // Screen-space delta
    vec2 delta = screen1.xy - screen0.xy;
    float len = max(abs(delta.x), abs(delta.y));

    // Nothing to trace
    if (len < 1.0) return vec4(0.0);

    // Clamp max steps for performance
    int max_steps = min(int(len), 256);
    vec2 step_dir = delta / len; // normalized, 1 pixel per step along major axis

    // Depth interpolation: we interpolate 1/z for perspective correctness
    float invZ0 = 1.0 / screen0.z;
    float invZ1 = 1.0 / screen1.z;

    // Jitter start position to reduce banding
    float jitter = fract(dot(vec2(gl_GlobalInvocationID.xy), vec2(0.75487766, 0.56984029)));
    vec2 pixel = screen0.xy + step_dir * jitter;
    float t = jitter / len;

    float prev_ray_z = screen0.z;

    for (int i = 0; i < max_steps; i++) {
        pixel += step_dir;
        t += 1.0 / len;
        if (t > 1.0) break;

        vec2 uv = pixel / u_screen_size;
        if (uv.x < 0.005 || uv.x > 0.995 || uv.y < 0.005 || uv.y > 0.995) break;

        // Perspective-correct depth interpolation along ray
        float ray_z = 1.0 / mix(invZ0, invZ1, t);
        float scene_z = linearizeDepth(texture(u_depth_tex, uv).r);

        // Hit: ray went behind geometry
        float diff = ray_z - scene_z;
        float thickness = max(ray_z * 0.05, 0.1); // adaptive thickness: 5% of depth or 0.1m

        if (diff > 0.0 && diff < thickness && prev_ray_z <= scene_z + 0.01) {
            // Binary refinement: step back half, repeat
            vec2 refine_pixel = pixel - step_dir;
            float refine_t = t - 1.0 / len;
            float half_step = 0.5;
            for (int j = 0; j < 8; j++) {
                refine_pixel += step_dir * half_step;
                refine_t += half_step / len;
                float rz = 1.0 / mix(invZ0, invZ1, refine_t);
                vec2 ruv = refine_pixel / u_screen_size;
                float sz = linearizeDepth(texture(u_depth_tex, ruv).r);
                if (rz > sz)  { refine_pixel -= step_dir * half_step; refine_t -= half_step / len; }
                half_step *= 0.5;
            }

            vec2 hit_uv = refine_pixel / u_screen_size;
            vec3 hit_color = texture(u_scene_tex, hit_uv).rgb;

            // Confidence fading
            float edge = smoothstep(0.0, 0.1, hit_uv.x) * smoothstep(1.0, 0.9, hit_uv.x)
                       * smoothstep(0.0, 0.1, hit_uv.y) * smoothstep(1.0, 0.9, hit_uv.y);
            float dist_fade = 1.0 - t; // linear fade with ray progress
            float thick_fade = 1.0 - smoothstep(0.0, thickness, diff);

            return vec4(hit_color, edge * dist_fade * thick_fade);
        }

        prev_ray_z = ray_z;
    }

    return vec4(0.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(u_screen_size.x) || gid.y >= int(u_screen_size.y)) return;

    vec2 uv = (vec2(gid) + 0.5) / u_screen_size;
    float depth = texture(u_depth_tex, uv).r;
    float linearZ = linearizeDepth(depth);

    if (linearZ > 40.0 || linearZ < 0.2) {
        imageStore(u_ssr_out, gid, vec4(0.0));
        return;
    }

    vec3 viewPos = viewPosFromUV(uv, linearZ);
    vec3 worldPos = (u_view_inv * vec4(viewPos, 1.0)).xyz;
    vec3 viewDir = normalize(viewPos);

    // Determine reflective surface and get normal
    vec3 reflNormal_view = vec3(0.0);
    float reflectivity = 0.0;

    // --- Mirror: known normal, no depth-reconstruction artifacts ---
    if (u_has_mirror > 0) {
        vec3 toPixel = worldPos - u_mirror_pos;
        float distAlongNormal = abs(dot(toPixel, u_mirror_normal));
        vec3 up_ref = abs(u_mirror_normal.y) > 0.9 ? vec3(1, 0, 0) : vec3(0, 1, 0);
        vec3 tangent = normalize(cross(up_ref, u_mirror_normal));
        vec3 bitangent = cross(u_mirror_normal, tangent);
        float uc = dot(toPixel, tangent);
        float vc = dot(toPixel, bitangent);

        if (distAlongNormal < 0.15 &&
            abs(uc) < u_mirror_half_size.x &&
            abs(vc) < u_mirror_half_size.y) {
            reflNormal_view = normalize((u_view * vec4(u_mirror_normal, 0.0)).xyz);
            float edgeU = 1.0 - smoothstep(u_mirror_half_size.x * 0.9, u_mirror_half_size.x, abs(uc));
            float edgeV = 1.0 - smoothstep(u_mirror_half_size.y * 0.9, u_mirror_half_size.y, abs(vc));
            reflectivity = edgeU * edgeV * 0.95;
        }
    }

    // --- Puddles ---
    if (reflectivity < 0.01) {
        for (int p = 0; p < u_puddle_count && p < 3; p++) {
            vec2 d = worldPos.xz - u_puddle_pos[p].xz;
            if (dot(d, d) < u_puddle_radius[p] * u_puddle_radius[p]) {
                vec3 vn = reconstructViewNormal(uv, linearZ);
                vec3 wn = normalize((u_view_inv * vec4(vn, 0.0)).xyz);
                reflNormal_view = vn;
                reflectivity = smoothstep(0.88, 0.98, max(wn.y, 0.0)) * 0.7;
                break;
            }
        }
    }

    if (reflectivity < 0.01) {
        imageStore(u_ssr_out, gid, vec4(0.0));
        return;
    }

    // Compute reflection direction and trace
    vec3 reflDir = reflect(viewDir, reflNormal_view);

    // Bias origin along reflection normal to avoid self-hit
    vec3 origin = viewPos + reflNormal_view * 0.05;

    vec4 result = ssrTrace(origin, reflDir);
    result.a *= reflectivity;

    imageStore(u_ssr_out, gid, result);
}
