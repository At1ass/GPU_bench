#version 430
layout(local_size_x = 16, local_size_y = 16) in;

// Input: source mip level (sampled)
uniform sampler2D u_src_tex;
// Output: destination mip level
layout(rgba32f, binding = 0) writeonly uniform image2D u_dst_tex;

uniform vec2 u_src_size;     // source texture dimensions
uniform int u_first_pass;    // 1 = apply Karis average (anti-firefly) + bright threshold, 0 = normal
uniform float u_bloom_threshold;  // brightness threshold for first pass (default 0.8)

// 13-tap tent filter (high quality downsample)
vec3 downsample13Tap(sampler2D tex, vec2 uv, vec2 texelSize) {
    // Center
    vec3 a = texture(tex, uv).rgb;
    // 4 inner samples
    vec3 b = texture(tex, uv + vec2(-1.0, -1.0) * texelSize).rgb;
    vec3 c = texture(tex, uv + vec2( 1.0, -1.0) * texelSize).rgb;
    vec3 d = texture(tex, uv + vec2(-1.0,  1.0) * texelSize).rgb;
    vec3 e = texture(tex, uv + vec2( 1.0,  1.0) * texelSize).rgb;
    // 4 edge samples
    vec3 f = texture(tex, uv + vec2(-2.0, 0.0) * texelSize).rgb;
    vec3 g = texture(tex, uv + vec2( 2.0, 0.0) * texelSize).rgb;
    vec3 h = texture(tex, uv + vec2(0.0, -2.0) * texelSize).rgb;
    vec3 i = texture(tex, uv + vec2(0.0,  2.0) * texelSize).rgb;
    // 4 far corners
    vec3 j = texture(tex, uv + vec2(-2.0, -2.0) * texelSize).rgb;
    vec3 k = texture(tex, uv + vec2( 2.0, -2.0) * texelSize).rgb;
    vec3 l = texture(tex, uv + vec2(-2.0,  2.0) * texelSize).rgb;
    vec3 m = texture(tex, uv + vec2( 2.0,  2.0) * texelSize).rgb;

    // Weighted combination (tent filter)
    vec3 result = a * 0.125;
    result += (b + c + d + e) * 0.125;
    result += (f + g + h + i) * 0.0625;
    result += (j + k + l + m) * 0.03125;

    return result;
}

// Karis average: weighted by inverse luminance to prevent fireflies
float karisWeight(vec3 c) {
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return 1.0 / (1.0 + luma);
}

vec3 downsampleKaris(sampler2D tex, vec2 uv, vec2 texelSize) {
    vec3 a = texture(tex, uv + vec2(-1.0, -1.0) * texelSize).rgb;
    vec3 b = texture(tex, uv + vec2( 1.0, -1.0) * texelSize).rgb;
    vec3 c = texture(tex, uv + vec2(-1.0,  1.0) * texelSize).rgb;
    vec3 d = texture(tex, uv + vec2( 1.0,  1.0) * texelSize).rgb;
    vec3 e = texture(tex, uv).rgb;

    float wa = karisWeight(a);
    float wb = karisWeight(b);
    float wc = karisWeight(c);
    float wd = karisWeight(d);
    float we = karisWeight(e);

    float sum_w = wa + wb + wc + wd + we;
    return (a * wa + b * wb + c * wc + d * wd + e * we) / max(sum_w, 0.001);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(u_dst_tex);

    if (gid.x >= dst_size.x || gid.y >= dst_size.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(dst_size);
    vec2 texelSize = 1.0 / u_src_size;

    vec3 color;
    if (u_first_pass > 0) {
        color = downsampleKaris(u_src_tex, uv, texelSize);
        // Brightness threshold: only bloom bright pixels (HDR > threshold)
        // Soft knee: smoothstep to avoid hard cutoff
        float brightness = dot(color, vec3(0.2126, 0.7152, 0.0722));
        float knee = u_bloom_threshold * 0.15;
        float soft = brightness - u_bloom_threshold + knee;
        soft = clamp(soft / (2.0 * knee + 0.0001), 0.0, 1.0);
        soft = soft * soft;
        float contrib = max(soft, step(u_bloom_threshold, brightness));
        color *= contrib;
    } else {
        color = downsample13Tap(u_src_tex, uv, texelSize);
    }

    imageStore(u_dst_tex, gid, vec4(color, 1.0));
}
