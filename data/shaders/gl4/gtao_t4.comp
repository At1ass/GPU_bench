#version 430
layout(local_size_x = 16, local_size_y = 16) in;

// Input: scene depth texture
uniform sampler2D u_depth_tex;
// Output: AO texture
layout(rgba32f, binding = 0) writeonly uniform image2D u_ao_out;

uniform vec2 u_screen_size;
uniform float u_near;
uniform float u_far;
uniform float u_aspect;
uniform float u_tan_half_fov;
uniform float u_ao_radius;
uniform float u_ao_intensity;

// Shared memory depth cache: tile + 2-pixel border = 20x20
shared float s_depth[20][20];

float linearizeDepth(float d) {
    return u_near * u_far / (u_far - d * (u_far - u_near));
}

// Reconstruct view-space position from UV + linear depth
vec3 viewPosFromUV(vec2 uv, float linearZ) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(
        ndc.x * u_tan_half_fov * u_aspect * linearZ,
        ndc.y * u_tan_half_fov * linearZ,
        -linearZ
    );
}

// Reconstruct view-space normal from depth buffer via cross-product
vec3 reconstructNormal(vec2 uv, float centerZ) {
    vec2 texel = 1.0 / u_screen_size;
    float dR = linearizeDepth(texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r);
    float dU = linearizeDepth(texture(u_depth_tex, uv + vec2(0.0, texel.y)).r);
    float dL = linearizeDepth(texture(u_depth_tex, uv - vec2(texel.x, 0.0)).r);
    float dD = linearizeDepth(texture(u_depth_tex, uv - vec2(0.0, texel.y)).r);

    vec3 center = viewPosFromUV(uv, centerZ);

    // Use smallest delta for better accuracy at edges
    vec3 right, up;
    if (abs(dR - centerZ) < abs(dL - centerZ))
        right = viewPosFromUV(uv + vec2(texel.x, 0.0), dR) - center;
    else
        right = center - viewPosFromUV(uv - vec2(texel.x, 0.0), dL);

    if (abs(dU - centerZ) < abs(dD - centerZ))
        up = viewPosFromUV(uv + vec2(0.0, texel.y), dU) - center;
    else
        up = center - viewPosFromUV(uv - vec2(0.0, texel.y), dD);

    return normalize(cross(right, up));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 screen_size = ivec2(u_screen_size);

    // Load depth into shared memory (tile + 2-pixel border = 20x20)
    ivec2 tile_origin = ivec2(gl_WorkGroupID.xy) * 16 - 2;
    for (int dy = lid.y; dy < 20; dy += 16) {
        for (int dx = lid.x; dx < 20; dx += 16) {
            ivec2 coord = tile_origin + ivec2(dx, dy);
            coord = clamp(coord, ivec2(0), screen_size - 1);
            vec2 uv = (vec2(coord) + 0.5) / u_screen_size;
            s_depth[dy][dx] = linearizeDepth(texture(u_depth_tex, uv).r);
        }
    }
    barrier();

    if (gid.x >= screen_size.x || gid.y >= screen_size.y) return;

    vec2 uv = (vec2(gid) + 0.5) / u_screen_size;
    float centerZ = s_depth[lid.y + 2][lid.x + 2];
    vec3 viewPos = viewPosFromUV(uv, centerZ);
    vec3 viewNormal = reconstructNormal(uv, centerZ);

    // Skip sky pixels (very far away)
    if (centerZ > 45.0) {
        imageStore(u_ao_out, gid, vec4(1.0));
        return;
    }

    // GTAO: horizon-based ambient occlusion
    // 12 directions, 6 steps per direction
    float ao = 0.0;
    float radius_pixels = u_ao_radius * u_screen_size.y / (centerZ * u_tan_half_fov * 2.0);
    radius_pixels = clamp(radius_pixels, 3.0, 96.0);

    // Per-pixel rotation jitter to break banding
    float angle_offset = fract(dot(vec2(gid), vec2(0.75487766, 0.56984029))) * 3.14159265;

    const int NUM_DIRS = 12;
    const int NUM_STEPS = 6;

    for (int d = 0; d < NUM_DIRS; d++) {
        float angle = (float(d) / float(NUM_DIRS)) * 3.14159265 * 2.0 + angle_offset;
        vec2 dir = vec2(cos(angle), sin(angle));

        // Track max horizon angle (sine of elevation)
        float maxHorizon = 0.0;

        for (int s = 1; s <= NUM_STEPS; s++) {
            // Non-linear step distribution: more samples near center for contact shadows
            float t_norm = float(s) / float(NUM_STEPS);
            float t = t_norm * t_norm * radius_pixels;
            if (t < 1.0) t = float(s);

            vec2 sampleUV = uv + dir * t / u_screen_size;

            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0)
                break;

            float sampleZ = linearizeDepth(texture(u_depth_tex, sampleUV).r);
            vec3 samplePos = viewPosFromUV(sampleUV, sampleZ);
            vec3 diff = samplePos - viewPos;
            float len = length(diff);

            if (len < 0.001) continue;

            // Horizon angle: how high is the sample relative to the surface
            float horizon = dot(diff / len, viewNormal);

            // Thickness rejection: ignore samples that are very far behind
            // (prevents thin geometry like grass from over-occluding)
            float depth_diff = abs(sampleZ - centerZ);
            float thickness_reject = 1.0 - smoothstep(u_ao_radius * 0.8, u_ao_radius * 3.0, depth_diff);

            // Distance falloff
            float falloff = 1.0 - t_norm * t_norm;
            horizon *= falloff * thickness_reject;

            maxHorizon = max(maxHorizon, horizon);
        }

        ao += clamp(maxHorizon, 0.0, 1.0);
    }

    ao /= float(NUM_DIRS);

    // Distance-based AO fade: reduce AO on distant objects to avoid over-darkening
    float dist_fade = 1.0 - smoothstep(5.0, 20.0, centerZ);
    ao *= dist_fade;

    ao = 1.0 - ao * u_ao_intensity;
    ao = clamp(ao, 0.25, 1.0);  // never fully black

    imageStore(u_ao_out, gid, vec4(ao, ao, ao, 1.0));
}
