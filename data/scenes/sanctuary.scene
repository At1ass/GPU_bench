# ============================================================
# Camera keypoints (Catmull-Rom spline orbit)
# 10 keypoints: position + look-at target
# ============================================================

[camera_0]
type = camera
position = 3.5 2.0 -3.0
target = 0.0 0.2 0.0

[camera_1]
type = camera
position = 3.0 0.8 3.0
target = 0.0 -0.2 0.0

[camera_2]
type = camera
position = 5.0 0.5 0.0
target = 0.0 0.1 0.0

[camera_3]
type = camera
position = 0.5 1.0 -4.0
target = 0.0 -0.3 -2.5

[camera_4]
type = camera
position = -2.5 3.2 2.5
target = 0.0 0.0 0.0

[camera_5]
type = camera
position = -3.5 0.6 2.0
target = 0.0 0.0 0.0

[camera_6]
type = camera
position = -5.0 0.5 -0.5
target = 0.0 0.1 0.0

[camera_7]
type = camera
position = -3.0 1.8 -3.0
target = 0.5 0.0 0.5

[camera_8]
type = camera
position = 0.3 3.8 0.2
target = 0.0 0.0 0.0

[camera_9]
type = camera
position = 3.5 2.0 -3.0
target = 0.0 0.2 0.0
