# GPU Benchmark Demo Scene — Sanctuary
# Format: [name]\nkey = value\n\n
#
# Mesh names: model, pedestal, ground, rock, grass,
#   column_tall, column_stump, arch, fallen_column,
#   slab, stone_sphere, mossy_block, bowl, obelisk,
#   ring_inner, ring_outer, pond, puddle0..2, tree0..2, torch
#
# Material names: skin, stone, rock, foliage, moss, water, terrain
#
# Special keys:
#   min_tier       = 1..4 (0 = all tiers, default 0)
#   fur            = true/false
#   vertex_wind    = true/false
#   is_water       = true/false
#   tessellated    = true/false/auto  (auto = follow tier config)
#   snap_to_terrain = true/false
#   shader_type    = model/island
#   two_sided      = true/false
#   roughness      = float
#   noise_scale    = float
#   warp_strength  = float
#   bounds_radius  = float (override auto-compute)
#   require_shadows = true/false (object only placed if shadows enabled)
#   require_ssr     = true/false (object only placed if SSR enabled)
#   require_point_lights = int (minimum point_light_count)

# ============================================================
# Central model — Stanford Bunny on pedestal
# ============================================================

[model]
mesh = model
pos = 0.0 0.40 -0.20
scale = 1.0 1.0 1.0
material = skin
tessellated = auto
bounds_radius = model

[pedestal]
mesh = pedestal
pos = 0.0 -1.0 -0.20
scale = 1.0 1.0 1.0
material = stone
tint = 0.50 0.47 0.42
roughness = 0.85
noise_scale = 1.5
tessellated = false
bounds_radius = 1.5

# ============================================================
# Ground plane
# ============================================================

[ground]
mesh = ground
pos = 0.0 -1.0 0.0
scale = 1.0 1.0 1.0
material = terrain
shader_type = island
tessellated = auto
bounds_radius = 12.0

# ============================================================
# Rocks (batched mesh)
# ============================================================

[rocks]
mesh = rock
pos = 0.0 0.0 0.0
scale = 1.0 1.0 1.0
material = rock
bounds_radius = 6.0

# ============================================================
# Grass tufts (T1 only — T2+ uses instanced grass)
# ============================================================

[grass]
mesh = grass
pos = 0.0 0.0 0.0
scale = 1.0 1.0 1.0
material = foliage
tint = 0.30 0.50 0.20
two_sided = true
vertex_wind = true
bounds_radius = 6.0
max_instanced_grass = 0

# ============================================================
# Columns — two tall flanking the arch
# ============================================================

[column_left]
mesh = column_tall
pos = -1.8 0.0 -2.5
scale = 1.0 1.0 1.0
material = stone
tint = 0.55 0.52 0.46
roughness = 0.90
snap_to_terrain = true
snap_to_terrain_pair = column_right
tessellated = false
bounds_radius = 2.0

[column_right]
mesh = column_tall
pos = 1.8 0.0 -2.5
scale = 1.0 1.0 1.0
material = stone
tint = 0.55 0.52 0.46
roughness = 0.90
snap_to_terrain = true
snap_to_terrain_pair = column_left
tessellated = false
bounds_radius = 2.0

# ============================================================
# Column stumps (T3+ — require point lights)
# ============================================================

[stump_left]
mesh = column_stump
pos = -3.0 0.0 -0.5
rotation = 0.0 0.0 5.0
scale = 1.0 1.0 1.0
material = stone
tint = 0.55 0.52 0.46
roughness = 0.90
noise_scale = 0.8
snap_to_terrain = true
tessellated = false
bounds_radius = 1.0
require_point_lights = 3

[stump_right]
mesh = column_stump
pos = 3.0 0.0 -0.5
rotation = 0.0 0.0 -3.0
scale = 1.0 1.0 1.0
material = stone
tint = 0.55 0.52 0.46
roughness = 0.90
noise_scale = 1.2
snap_to_terrain = true
tessellated = false
bounds_radius = 1.0
require_point_lights = 3

# ============================================================
# Arch (T2+ — requires shadows)
# ============================================================

[arch]
mesh = arch
pos = 0.0 0.0 -2.5
scale = 1.0 1.0 1.0
material = stone
tint = 0.48 0.45 0.40
roughness = 0.92
warp_strength = 0.4
tessellated = auto
bounds_radius = 2.5
require_shadows = true
arch_on_columns = true

